{
  "name": "xy-storage",
  "type": "module",
  "version": "4.0.0",
  "description": "本地缓存解决方案",
  "author": {
    "name": "mengxianghan",
    "email": "mengxianghan@qq.com"
  },
  "license": "MIT",
  "homepage": "https://github.com/mengxianghan/xy-storage#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mengxianghan/xy-storage.git"
  },
  "bugs": {
    "url": "https://github.com/mengxianghan/xy-storage/issues"
  },
  "keywords": [
    "storage",
    "localStorage",
    "sessionStorage",
    "cookie"
  ],
  "exports": {
