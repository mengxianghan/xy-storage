    "build": "rollup -c",
    "test": "vitest",
    "prepare": "husky"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "peerDependencies": {
    "js-cookie": "^3.0.5"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^6.1.0",
    "@babel/core": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
